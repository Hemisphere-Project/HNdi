CONF_PATHS = ['/boot/firmware/hndi.conf', '/boot/hndi.conf']
STATE_DIRS = ['/data/var/hndi', '/var/tmp/hndi']
CHANNEL = 'hndi'
# v4l2sink requires these fields fixed in the caps it is offered; intervideosrc fixates
# without them (subset check fails → not-negotiated). capssetter adds them, zero-copy.
SHIM = 'interlace-mode=progressive,pixel-aspect-ratio=1/1,multiview-mode=mono'
RESOLVE_INTERVAL_S = 3
log = logging.getLogger('hndi-in')


# ── config ────────────────────────────────────────────────────────────────
DEFAULTS = {
    'input': {
        'source': '', 'width': '1920', 'height': '1080', 'fps': '', 'format': 'UYVY',
        'device': '10', 'bandwidth': 'highest', 'receiver_name': '',
        'hold_ms': '', 'stall_ms': '800', 'dead_ms': '8000', 'timeout': '2000',  # timeout = legacy alias for hold_ms
        'profile': 'lowlatency', 'jitter_ms': '',   # lowlatency (Ethernet) | robust (WiFi jitter buffer)
        'nosignal': 'black', 'api_port': '8791', 'api_bind': '127.0.0.1',   # api_bind 0.0.0.0 = LAN-visible (a Régie on another box lists our sources)
        'size': 'fixed',   # fixed = width/height are the device caps; follow = the caps track the NDI source's frame size
        'autopick': 'true',   # false = never connect to "the first source found": no source until a cue (PUT /source) names one
    },
    'discovery': {'server': '', 'ips': ''},
}


def load_config(path=None):
    cfg = configparser.ConfigParser(inline_comment_prefixes=('#', ';'))
    cfg.read_dict(DEFAULTS)
    used = None
    for p in ([path] if path else CONF_PATHS):
        if p and os.path.isfile(p):
            cfg.read(p)
            used = p
            break
    c = cfg['input']
    fps = c.get('fps').strip()
    conf = {
        'path': used,
        'source': c.get('source').strip(),
        'width': int(c.get('width') or 1920),
        'height': int(c.get('height') or 1080),
        'fps': int(fps) if fps else 0,
        'format': (c.get('format').strip() or 'YUY2').upper(),
        'device': int(c.get('device') or 10),
        'bandwidth': (c.get('bandwidth').strip() or 'highest').lower(),
        'hold_ms': int(c.get('hold_ms') or c.get('timeout') or 1500),   # hold last frame this long, then black
        'stall_ms': int(c.get('stall_ms') or 800),                       # no frame this long → 'stalled' (ride it out)
        'dead_ms': int(c.get('dead_ms') or 8000),                        # no frame this long → reconnect
        'profile': (c.get('profile') or 'lowlatency').strip().lower(),
        'receiver_name': c.get('receiver_name').strip() or f'{socket.gethostname()} (HNdi)',
        'nosignal': c.get('nosignal').strip() or 'black',
        'api_port': int(c.get('api_port') or 8791),
        'api_bind': (c.get('api_bind') or '127.0.0.1').strip() or '127.0.0.1',
        'size': (c.get('size') or 'fixed').strip().lower(),
        'autopick': (c.get('autopick') or 'true').strip().lower() not in ('0', 'false', 'no', 'off'),
        'discovery_server': cfg['discovery'].get('server').strip(),
        'discovery_ips': ','.join(x.strip() for x in cfg['discovery'].get('ips', '').split(',') if x.strip()),
    }
    if conf['bandwidth'] not in ('highest', 'lowest', 'auto'):
        conf['bandwidth'] = 'highest'
    if conf['profile'] not in ('lowlatency', 'robust'):
        conf['profile'] = 'lowlatency'
    if conf['size'] not in ('fixed', 'follow'):
        conf['size'] = 'fixed'
    jit = c.get('jitter_ms')
    conf['jitter_ms'] = int(jit) if jit else (100 if conf['profile'] == 'robust' else 0)  # receive jitter buffer
    conf['ndi_queue'] = 8 if conf['profile'] == 'robust' else 2                            # ndisrc internal queue
    return conf


def state_dir():
    for d in STATE_DIRS:
        try:
            os.makedirs(d, exist_ok=True)
            if os.access(d, os.W_OK):
                return d
        except OSError:
            pass
    return '/tmp'


def write_ndi_config(conf, sdir):
    """libndi reads $NDI_CONFIG_DIR/ndi-config.v1.json; the service sets NDI_CONFIG_DIR."""
    d = os.path.join(sdir, 'ndi')
    os.makedirs(d, exist_ok=True)
    p = os.path.join(d, 'ndi-config.v1.json')
    # ips: senders the finder asks DIRECTLY (unicast, their TCP 5960) — every source on those
    # machines is listed whether or not their mDNS announcements reach this box (the show
    # switch delivered them unevenly on 2026-09-16: casa saw two of four, a mini one)
    doc = {'ndi': {'networks': {'discovery': conf['discovery_server'], 'ips': conf['discovery_ips']},
                   'rudp': {'send': {'enable': True}, 'recv': {'enable': True}}}}
    try:
        with open(p, 'w') as f:
            json.dump(doc, f, indent=1)
    except OSError as e:
        log.warning('cannot write %s: %s', p, e)


# ── node ──────────────────────────────────────────────────────────────────
class Node:
    def __init__(self, conf, sdir, dry_run=False):
        self.conf = conf
        self.sdir = sdir
        self.state_file = os.path.join(sdir, 'state.json')
        self.lock = threading.Lock()
        self.loop = GLib.MainLoop()
        self.state = 'stopped'
        self.override = self._load_override()
        self.mode = conf['bandwidth']                       # configured: highest | lowest | auto
        self.auto = (self.mode == 'auto')
        self.bandwidth = 'highest' if self.auto else self.mode   # effective NDI bandwidth
        self._bad = 0; self._good = 0; self._fps_baseline = 0.0; self._last_bw_switch = 0.0
        self.resolved = None          # {'name', 'url'} of the source we are connected to
        self.frames = 0
        self.fps_measured = 0.0
        self._fps_frames = 0
        self._fps_t = time.monotonic()
        self.last_frame_t = None
        self.restarts = 0
        self.stalled = False          # frames paused but the receiver is kept (ride-out)
        self.slate_pipe = None        # 'no signal' card while searching/reconnecting
        self.started_at = time.time()
        self.out_pipe = None
        self.in_pipe = None
        self.monitor = None
        self._sources_cache = ([], 0.0)
        self._resolve_id = None
        self._sse = []                # list of queue.Queue
        self.dry_run = dry_run
        # size=follow: the loopback caps track the NDI source's frame size — but only when
        # nothing reads the device. A reader (mpv on a cue) keeps the caps it opened; the
        # new size waits in pending_size and is adopted when the last reader closes.
        self.follow = (conf['size'] == 'follow')
        self.source_size = None       # (w, h) seen on the NDI branch, before scaling
        self.pending_size = None      # (w, h) to adopt once /dev/videoN has no reader
        self.out_frames = 0           # frames written to the device by the current output pipeline
        self._fail_streak = 0         # consecutive failed connects (a stale address is re-resolved through mDNS)
        self._avahi_seen = {}         # name → monotonic time of the last '+' on the avahi browse
        self._avahi_gone = {}         # name → monotonic time of the last '-' (withdrawn)
        self._dead = {}               # name → consecutive TCP knocks unanswered (≥ 3 hides the entry)
        self._out_retry_t = 0.0       # last writer rebuild attempted from an output error
        self._pending_logged = False
        self._retry_id = None

    # persisted override ------------------------------------------------
    def _load_override(self):
        try:
            with open(self.state_file) as f:
                return (json.load(f).get('source') or '').strip()
        except (OSError, ValueError):
            return ''

    def _save_override(self, name):
        try:
            with open(self.state_file, 'w') as f:
                json.dump({'source': name, 'saved_at': time.time()}, f)
        except OSError as e:
            log.warning('cannot persist override: %s', e)

    def wanted_source(self):
        return self.override or self.conf['source']

    # pipelines ---------------------------------------------------------
    def probe_colorimetry(self):
        """The loopback device advertises one colorimetry per format (v4l2loopback: sRGB);
        offering anything else is refused, so read it from v4l2sink's probed caps."""
        if getattr(self, '_colorimetry', None):
            return self._colorimetry
        col = 'sRGB'
        try:
            s = Gst.ElementFactory.make('v4l2sink')
            s.set_property('device', f'/dev/video{self.conf["device"]}')
            if s.set_state(Gst.State.READY) != Gst.StateChangeReturn.FAILURE:
                caps = s.get_static_pad('sink').query_caps(None)
                for i in range(caps.get_size()):
                    st = caps.get_structure(i)
                    if st.get_string('format') == self.conf['format']:
                        m = re.search(r'colorimetry=\(string\)\{?\s*([^,}\s;]+)', st.to_string())
                        if m:
                            col = m.group(1)
                            break
            s.set_state(Gst.State.NULL)
        except Exception as e:  # noqa: BLE001
            log.warning('colorimetry probe failed: %s', e)
        self._colorimetry = col
        return col

    def caps_shim(self):
        return f'capssetter join=true caps=video/x-raw,{SHIM},colorimetry={self.probe_colorimetry()}'

    def out_desc(self):
        c = self.conf
        fps = c['fps'] or 60
        # intervideosrc takes the channel's caps as they come (a size=follow swap leaves one
        # frame of the previous size in the channel): scale/convert sit in front of the fixed
        # caps so a transient mismatch is resized instead of failing negotiation — passthrough
        # (no copy) whenever the sizes already agree, which is always after the first frame.
        return (f'intervideosrc channel={CHANNEL} timeout={c["hold_ms"] * 1000000} '
                f'! videoscale ! videoconvert '
                f'! video/x-raw,format={c["format"]},width={c["width"]},height={c["height"]},framerate={fps}/1 '
                f'! {self.caps_shim()} '
                f'! queue max-size-buffers=2 leaky=downstream '
                f'! v4l2sink name=v4l2 device=/dev/video{c["device"]} sync=true')   # sync=true: the sink paces intervideosrc at the caps framerate

    def in_caps(self):
        c = self.conf
        return f'video/x-raw,format={c["format"]},width={c["width"]},height={c["height"]},pixel-aspect-ratio=1/1'

    def in_desc(self, src):
        c = self.conf
        bw = 0 if self.bandwidth == 'lowest' else 100          # ndisrc bandwidth is an int: 100 = highest, 0 = lowest (NDI proxy)
        if src.get('url'):
            sel = f'url-address="{src["url"]}"'
        else:
            sel = f'ndi-name="{src["name"]}"'
        rate = f'! videorate ! video/x-raw,framerate={c["fps"]}/1 ' if c['fps'] else ''
        j = c['jitter_ms']
        if j > 0:   # robust: a receive-side jitter buffer absorbs WiFi jitter (~j ms extra latency)
            vq = (f'queue max-size-time={3 * j * 1000000} min-threshold-time={j * 1000000} '
                  f'max-size-buffers=0 max-size-bytes=0 leaky=downstream')
        else:       # lowlatency: hold nothing back
            vq = 'queue max-size-buffers=1 leaky=downstream'
        return (f'ndisrc {sel} receiver-ndi-name="{c["receiver_name"]}" bandwidth={bw} '
                f'timeout={c["dead_ms"] + 5000} connect-timeout=10000 max-queue-length={c["ndi_queue"]} color-format=uyvy-bgra '
                f'! ndisrcdemux name=d d.video ! {vq} '
                f'! identity name=srcsize silent=true '        # size=follow: the CAPS event here carries the source's frame size
                f'! videoconvert n-threads=4 ! videoscale add-borders=true '
                f'! capsfilter name=incaps caps={self.in_caps()} '   # PAR 1/1 → a mismatched source is letterboxed, never stretched; swapped in place by size=follow
                f'{rate}! {self.caps_shim()} '      # same tags as the output side → intervideosrc passes frames through untouched
                f'! intervideosink name=ivsink channel={CHANNEL} sync=false')

    def start(self):
        if self.dry_run:
            print('output:', self.out_desc())
            print('input :', self.in_desc({'name': self.wanted_source() or '<first source found>'}))
            return
        if self.follow:
            # restarted while a reader holds the device (a cue on air): the loopback keeps the
            # reader's format, so open at that size — the source size is adopted at the next cue
            held = self.device_readers()
            cur = self.device_format() if held else None
            if cur and cur != (self.conf['width'], self.conf['height']):
                log.info('device held by pid %s at %dx%d — starting at that size', ','.join(map(str, held)), *cur)
                self.conf['width'], self.conf['height'] = cur
        if not self._build_output():
            raise SystemExit('output pipeline failed to start (is /dev/video%d a v4l2loopback device?)' % self.conf['device'])
        self.monitor = Gst.DeviceMonitor()
        self.monitor.add_filter('Source/Network', Gst.Caps.from_string('application/x-ndi'))
        self.monitor.start()
        threading.Thread(target=self._avahi_watch, daemon=True, name='avahi').start()
        threading.Thread(target=self._liveness_watch, daemon=True, name='liveness').start()
        self._set_state('resolving')
        self._resolve_id = GLib.timeout_add_seconds(RESOLVE_INTERVAL_S, self._resolve_tick)
        GLib.timeout_add(1000, self._second_tick)
        # first resolve right away, ONCE. _resolve_tick returns True because it is a
        # timeout source; an idle source that returns True is re-run forever — a 100 %
        # CPU spin in every state, and get_devices() leaks a few bytes per call, so an
        # idle box grew to 13.9 G and was OOM-killed every ~30 min (hmini-001, 2026-09-04).
        GLib.idle_add(lambda: (self._resolve_tick(), False)[1])

    def stop(self):
        self._stop_input()
        self._stop_slate()
        if self.out_pipe:
            self.out_pipe.set_state(Gst.State.NULL)
            self.out_pipe = None
        if self.monitor:
            self.monitor.stop()
        self._set_state('stopped')
        self.loop.quit()

    # discovery ---------------------------------------------------------
    def sources(self, max_age=10.0):
        lst, t = self._sources_cache
        if time.monotonic() - t < max_age and lst:
            return lst
        out = self._raw_sources()
        # the provider also never forgets: a sender that quit (or a laptop that left) stays
        # listed for the life of the daemon. avahi does forget — a goodbye or a TTL expiry
        # is a '-' event on the continuous browse — so a name avahi has withdrawn (and not
        # seen since) is dropped. Names avahi merely has not mentioned stay: mDNS delivery
        # is flaky per box, the provider's memory is what papers over that.
        gone = {n for n, t in self._avahi_gone.items() if t > self._avahi_seen.get(n, 0.0)}
        # and a sender gone without a goodbye keeps its record for the mDNS TTL (up to 75 min):
        # the liveness thread knocks on each ip:port, three misses in a row hide the entry; a
        # withdrawn name is hidden at the first miss — and kept while its port still answers,
        # because a withdrawal on a flaky-multicast LAN says nothing about the sender
        out = [e for e in out if self._dead.get(e['name'], 0) < (1 if e['name'] in gone else 3)]
        self._sources_cache = (out, time.monotonic())
        return out

    def _raw_sources(self):
        """The device provider's list, newest entry per name."""
        out, by_name = [], {}
        if self.monitor:
            for d in self.monitor.get_devices():
                props = d.get_properties()
                name = (props.get_string('ndi-name') if props and props.has_field('ndi-name') else None) or d.get_display_name()
                url = props.get_string('url-address') if props and props.has_field('url-address') else ''
                entry = {'name': name, 'url': url or ''}
                # the device provider only ever adds: a sender that changed address or port
                # (a laptop re-addressed on site, a Resolume screen re-created) is listed
                # twice, the stale entry first — keep the newest per name
                if name in by_name:
                    out[by_name[name]] = entry
                else:
                    by_name[name] = len(out)
                    out.append(entry)
        return out

    def _liveness_watch(self):
        """Thread: every 20 s a TCP knock on each listed sender's ip:port (an NDI sender
        listens there). A laptop unplugged or re-addressed answers nothing at once, while its
        mDNS record lingers until the TTL runs out; three misses in a row hide it, one answer
        brings it back."""
        while True:
            time.sleep(20)
            try:
                for e in self._raw_sources():
                    url = e.get('url') or ''
                    if ':' not in url:
                        continue
                    host, port = url.rsplit(':', 1)
                    try:
                        socket.create_connection((host, int(port)), timeout=1.5).close()
                        if self._dead.pop(e['name'], 0) >= 3:
                            log.info('%s answers again at %s', e['name'], url)
                            self._sources_cache = ([], 0.0)
                    except OSError:
                        n = self._dead.get(e['name'], 0) + 1
                        self._dead[e['name']] = n
                        if n == 3:
                            log.info('%s does not answer at %s — hidden until it does', e['name'], url)
                            self._sources_cache = ([], 0.0)
            except Exception as ex:  # noqa: BLE001 — never let the watcher die
                log.warning('liveness watch: %s', ex)

    @staticmethod
    def _avahi_unescape(s):
        """avahi -p escapes bytes as \\NNN (decimal): rebuild the bytes, then decode UTF-8 — an
        accented NDI name ('Arena - 2x Scène') must match the provider's name byte for byte."""
        raw = re.sub(r'\\(\d{3})', lambda m: bytes([int(m.group(1))]).decode('latin-1'), s)
        try:
            return raw.encode('latin-1').decode('utf-8')
        except (UnicodeEncodeError, UnicodeDecodeError):
            return raw

    def _avahi_watch(self):
        """Thread: a continuous `avahi-browse _ndi._tcp`; '+' marks a name seen, '-' a name
        withdrawn (sender goodbye, TTL). Restarted if it dies; silent when avahi is absent."""
        while True:
            try:
                proc = subprocess.Popen(['avahi-browse', '-p', '_ndi._tcp'], stdout=subprocess.PIPE,
                                        stderr=subprocess.DEVNULL, text=True)
                for line in proc.stdout:
                    f = line.rstrip('\n').split(';')
                    if len(f) < 4 or f[0] not in ('+', '-'):
                        continue
                    name = self._avahi_unescape(f[3])
                    if f[0] == '+':
                        self._avahi_seen[name] = time.monotonic()
                    else:
                        self._avahi_gone[name] = time.monotonic()
                        log.info('mDNS withdrew %s', name)
                    self._sources_cache = ([], 0.0)
                proc.wait()
            except (OSError, subprocess.SubprocessError) as e:
                log.warning('avahi browse unavailable: %s', e)
                return
            time.sleep(5)

    def _avahi_resolve(self, name):
        """Fresh ip:port for an NDI source name from an mDNS resolve (a few seconds), or ''."""
        try:
            out = subprocess.run(['avahi-browse', '-rpt', '_ndi._tcp'], capture_output=True, text=True, timeout=12).stdout
        except (OSError, subprocess.SubprocessError):
            return ''
        for line in out.splitlines():
            f = line.split(';')
            if len(f) >= 9 and f[0] == '=' and self._avahi_unescape(f[3]) == name and f[2] == 'IPv4':
                return f'{f[7]}:{f[8]}'
        return ''

    def _pick(self):
        want = self.wanted_source()
        if want.startswith('ndi://'):
            return {'name': want, 'url': want[6:]}
        if want and ':' in want and want.replace('.', '').replace(':', '').isdigit():
            return {'name': want, 'url': want}       # bare ip:port → direct, no discovery
        if not want and not self.conf['autopick']:
            return None                              # a show box shows nothing until a cue names a source
        srcs = self.sources(max_age=0)
        src = self._match(want, srcs) if want else (srcs[0] if srcs else None)
        if src and self._fail_streak and src.get('url'):
            # the connect just failed: the provider may hold the address the sender had
            # before it moved (a laptop re-addressed on site) — ask mDNS for the current one
            fresh = self._avahi_resolve(src['name'])
            if fresh and fresh != src['url']:
                log.info('%s moved: %s → %s (mDNS)', src['name'], src['url'], fresh)
                src = dict(src, url=fresh)
        return src

    @staticmethod
    def _match(want, srcs):
        """NDI advertises "MACHINE (source)"; an operator writes what they know — the
        full name, just the part in parentheses, or a fragment. Exact wins, then the
        "(want)" suffix, then a case-insensitive substring. (kmini-001, 2026-09-04: a cue
        naming "HNDI-TEST" dropped a running "KMINI-001 (HNDI-TEST)" feed and searched
        forever, because only the exact name matched.)"""
        for s in srcs:
            if s['name'] == want:
                return s
        for s in srcs:
            if s['name'].endswith('(' + want + ')'):
                return s
        w = want.lower()
        for s in srcs:
            if w in s['name'].lower():
                return s
        return None

    def _build_output(self):
        """(Re)build the persistent loopback writer at the current conf size."""
        if self.out_pipe:
            self.out_pipe.set_state(Gst.State.NULL)
            self.out_pipe = None
        self.out_frames = 0           # v4l2loopback is capture-ready only once the writer streamed a frame
        self.out_pipe = Gst.parse_launch(self.out_desc())
        bus = self.out_pipe.get_bus()
        bus.add_signal_watch()
        bus.connect('message::error', self._on_out_error)
        self.out_pipe.get_by_name('v4l2').get_static_pad('sink').add_probe(
            Gst.PadProbeType.BUFFER, self._on_out_frame, None)
        if self.out_pipe.set_state(Gst.State.PLAYING) == Gst.StateChangeReturn.FAILURE:
            return False
        log.info('output pipeline up: /dev/video%d %s %dx%d', self.conf['device'], self.conf['format'], self.conf['width'], self.conf['height'])
        return True

    def _on_out_frame(self, pad, info, _):
        self.out_frames += 1
        return Gst.PadProbeReturn.OK

    def _resolve_tick(self):
        if self.state not in ('resolving', 'retrying'):
            return True
        src = self._pick()
        if not src:
            if self.state != 'resolving':
                self._set_state('resolving')
            return True
        self._start_input(src)
        return True

    # input pipeline ----------------------------------------------------
    def _start_input(self, src):
        self._stop_input()
        self._stop_slate()
        desc = self.in_desc(src)
        log.info('connecting to %s (%s) bandwidth=%s', src['name'], src.get('url') or 'discovered', self.bandwidth)
        try:
            self.in_pipe = Gst.parse_launch(desc)
        except GLib.Error as e:
            log.error('input pipeline parse error: %s', e)
            self._set_state('retrying')
            return
        bus = self.in_pipe.get_bus()
        bus.add_signal_watch()
        bus.connect('message::error', self._on_in_error)
        bus.connect('message::eos', self._on_in_eos)
        sink = self.in_pipe.get_by_name('ivsink')
        sink.get_static_pad('sink').add_probe(Gst.PadProbeType.BUFFER, self._on_frame, None)
        self.in_pipe.get_by_name('srcsize').get_static_pad('sink').add_probe(
            Gst.PadProbeType.EVENT_DOWNSTREAM, self._on_src_event, None)
        self.resolved = src
        self.last_frame_t = None
        self.source_size = None       # unknown until this branch's CAPS event
        self._set_state('connecting')
        if self.in_pipe.set_state(Gst.State.PLAYING) == Gst.StateChangeReturn.FAILURE:
            log.error('input pipeline refused to start')
            self._schedule_retry()

    def _stop_input(self):
        if self.in_pipe:
            self.in_pipe.set_state(Gst.State.NULL)
            self.in_pipe = None

    # ---- 'no signal' slate (nosignal=slate): a card shown on the device while there
    #      is no live input, instead of black. Feeds the SAME inter channel; only ever
    #      runs while the input pipeline is torn down (resolving/retrying), so no overlap.
    def _start_slate(self):
        if self.conf['nosignal'] != 'slate' or self.dry_run or self.slate_pipe or not self.out_pipe:
            return
        c = self.conf
        fps = c['fps'] or 60
        try:
            self.slate_pipe = Gst.parse_launch(
                f'videotestsrc pattern=solid-color foreground-color=0xff141c28 is-live=true '
                f'! video/x-raw,format={c["format"]},width={c["width"]},height={c["height"]},framerate={fps}/1 '
                f'! textoverlay name=slatetxt valignment=center halignment=center font-desc="Monospace 40" shaded-background=true '
                f'! {self.caps_shim()} ! intervideosink channel={CHANNEL} sync=false')
            src = self.wanted_source() or ('waiting for a cue' if not self.conf['autopick'] else 'searching for a source…')
            self.slate_pipe.get_by_name('slatetxt').set_property(
                'text', f'NO NDI SIGNAL\n{socket.gethostname()}\n{src}')
            self.slate_pipe.set_state(Gst.State.PLAYING)
        except GLib.Error as e:
            log.warning('slate pipeline failed: %s', e); self.slate_pipe = None

    def _stop_slate(self):
        if self.slate_pipe:
            self.slate_pipe.set_state(Gst.State.NULL)
            self.slate_pipe = None

    def _schedule_retry(self):
        self._stop_input()
        self.restarts += 1
        self._fail_streak += 1
        self._set_state('retrying')

    def _on_frame(self, pad, info, _):
        self.frames += 1
        self._fps_frames += 1
        self.last_frame_t = time.monotonic()
        self.stalled = False
        if self.state == 'connecting':
            self._fail_streak = 0
            GLib.idle_add(self._set_state, 'running')
        return Gst.PadProbeReturn.OK

    # size=follow ------------------------------------------------------
    def _on_src_event(self, pad, info, _):
        ev = info.get_event()
        if ev and ev.type == Gst.EventType.CAPS:
            st = ev.parse_caps().get_structure(0)
            ok_w, w = st.get_int('width'); ok_h, h = st.get_int('height')
            if ok_w and ok_h and (w, h) != self.source_size:
                self.source_size = (w, h)
                log.info('source frame size %dx%d', w, h)
                GLib.idle_add(self._on_source_size, w, h)
        return Gst.PadProbeReturn.OK

    def _on_source_size(self, w, h):
        if not self.follow:
            return False
        c = self.conf
        if (w, h) == (c['width'], c['height']):
            self.pending_size = None
            return False
        self.pending_size = (w, h)
        self._pending_logged = False
        self._apply_pending_size()
        return False

    def size_settled(self):
        """True when the device caps are the right ones for the source on air: fixed mode
        always; follow mode once the current branch reported its frame size and it matches.
        A player asking PUT /source with a wait gets its answer when this turns True."""
        if not self.follow:
            return True
        return self.source_size is not None and self.pending_size is None and self.out_frames > 0

    def device_readers(self):
        """PIDs pinning /dev/videoN, ours excluded (mpv on a cue, Chrome on a kiosk): an open
        fd, or a mapping — mpv keeps its mmap'ed capture buffers after closing the fd while a
        DQBUF is stuck (writer gone), and a mapping alone keeps v4l2loopback's open_count up."""
        dev = f'/dev/video{self.conf["device"]}'
        me = os.getpid(); pids = []
        for p in os.listdir('/proc'):
            if not p.isdigit() or int(p) == me:
                continue
            try:
                hit = any(os.readlink(f'/proc/{p}/fd/{fd}') == dev for fd in os.listdir(f'/proc/{p}/fd'))
                if not hit:
                    with open(f'/proc/{p}/maps') as f:
                        hit = any(line.rstrip().endswith(dev) for line in f)
                if hit:
                    pids.append(int(p))
            except OSError:
                continue
        return pids

    def device_format(self):
        """(w, h) the loopback is pinned to, or None. A reader keeps the writer's format alive
        after the writer is gone (v4l2loopback 0.15: sysfs `format` = "YUYV:512x512@60"; the
        capture-side G_FMT answers EINVAL then, the output side still knows)."""
        n = self.conf['device']
        try:
            with open(f'/sys/devices/virtual/video4linux/video{n}/format') as f:
                m = re.search(r':(\d+)x(\d+)@', f.read())
            if m:
                return (int(m.group(1)), int(m.group(2)))
        except OSError:
            pass
        try:
            out = subprocess.run(['v4l2-ctl', '-d', f'/dev/video{n}', '--get-fmt-video-out'],
                                 capture_output=True, text=True, timeout=3).stdout
            m = re.search(r'Width/Height\s*:\s*(\d+)/(\d+)', out)
            return (int(m.group(1)), int(m.group(2))) if m else None
        except (OSError, subprocess.SubprocessError):
            return None

    def _retry_pending_size(self):
        self._retry_id = None
        self._apply_pending_size()
        return False

    def _apply_pending_size(self):
        """Adopt pending_size as the loopback caps — only when no reader holds the device.
        Rebuilds the output pipeline (new caps on v4l2sink) and the input branch (its
        caps filter), then reconnects the same source; a reader keeps what it opened."""
        if not self.pending_size or self.dry_run:
            return
        readers = self.device_readers()
        if readers:
            if not self._pending_logged:
                log.info('source is %dx%d, device caps stay %dx%d while pid %s reads it — adopting when it closes',
                         *self.pending_size, self.conf['width'], self.conf['height'], ','.join(map(str, readers)))
                self._pending_logged = True
            if not self._retry_id:   # a player closing the device for a cue change frees it within ms: look again soon
                self._retry_id = GLib.timeout_add(150, self._retry_pending_size)
            return
        w, h = self.pending_size
        log.info('adopting source size %dx%d as the device caps (was %dx%d)', w, h, self.conf['width'], self.conf['height'])
        self._stop_slate()
        self.conf['width'], self.conf['height'] = w, h
        self.pending_size = None
        inplace = self.in_pipe is not None and self.source_size == (w, h)
        if inplace:
            # the branch reporting this size stays connected: its caps filter takes the new
            # size and the scaler renegotiates on the next frame — no NDI reconnect (2.7 s
            # against a busy sender, kmini-007 2026-09-14), no black
            self.in_pipe.get_by_name('incaps').set_property('caps', Gst.Caps.from_string(self.in_caps()))
        else:
            self.source_size = None   # settled only once a fresh branch reports its size
            self._stop_input()
        if not self._build_output():
            log.error('output pipeline failed to restart at %dx%d — exiting so systemd restarts us', w, h)
            self.stop(); return
        self.restarts += 1
        if not inplace:
            if self.resolved:
                self._start_input(self.resolved)
            else:
                self._set_state('resolving')
        self._push_sse()

    def _on_in_error(self, bus, msg):
        err, dbg = msg.parse_error()
        log.warning('input error: %s (%s)', err.message, (dbg or '').splitlines()[0] if dbg else '')
        self._schedule_retry()

    def _on_in_eos(self, bus, msg):
        log.warning('input EOS')
        self._schedule_retry()

    def _on_out_error(self, bus, msg):
        err, _ = msg.parse_error()
        if time.monotonic() - self._out_retry_t > 10:
            # a transient (seen once right after an adoption): one rebuild before giving up
            self._out_retry_t = time.monotonic()
            log.warning('OUTPUT pipeline error: %s — rebuilding the writer once', err.message)
            if self._build_output():
                return
        log.error('OUTPUT pipeline error: %s — exiting so systemd restarts us', err.message)
        self.stop()

    def _second_tick(self):
        now = time.monotonic()
        dt = now - self._fps_t
        if dt >= 1.0:
            self.fps_measured = round(self._fps_frames / dt, 1)
            self._fps_frames = 0
            self._fps_t = now
        if self.state == 'running' and self.last_frame_t:
            age = (now - self.last_frame_t) * 1000
            if age > self.conf['dead_ms']:
                log.warning('no frame for %d ms — reconnecting', int(age)); self.stalled = False
                self._schedule_retry()                     # genuinely dead → tear down + reconnect
            else:
                stalled = age > self.conf['stall_ms']      # brief gap → ride it out, keep the NDI receiver
                if stalled and not self.stalled:
                    log.info('stalled (no frame %d ms) — holding, receiver kept', int(age))
                self.stalled = stalled
        elif self.state == 'connecting' and self.last_frame_t is None and self.in_pipe:
            waited = now - self._state_t
            if waited > 15:
                log.warning('no first frame after 15 s — restarting input')
                self._schedule_retry()
            elif waited * 1000 > self.conf['hold_ms']:
                self._start_slate()      # connecting but no frames yet → show the slate, not black
        if self.auto:
            self._auto_bandwidth()
        if self.pending_size:
            self._apply_pending_size()
        self._push_sse(heartbeat=True)
        return True

    # bandwidth=auto: while connected, learn the healthy fps, score degradation, and drop
    # to the NDI proxy stream ('lowest') under sustained trouble — recover to 'highest' when
    # clean again. Each switch is a deliberate input restart, rate-limited to avoid flapping.
    def _auto_bandwidth(self):
        if self.state != 'running':
            return                                   # a full dropout is the reconnect path's job, not bandwidth's
        if not self.stalled and self.fps_measured > 0:
            self._fps_baseline = max(self._fps_baseline, self.fps_measured)
        bad = self.stalled or (self._fps_baseline and self.fps_measured < self._fps_baseline * 0.5)
        if bad:
            self._bad = min(12, self._bad + 1); self._good = 0
        else:
            self._bad = max(0, self._bad - 1); self._good += 1
        now = time.monotonic()
        dwell = now - self._last_bw_switch
        if self.bandwidth == 'highest' and self._bad >= 5 and dwell > 30 and self.resolved:
            log.warning('link degraded (score %d) → bandwidth lowest (proxy)', self._bad)
            self.bandwidth = 'lowest'; self._last_bw_switch = now; self._bad = 0; self._good = 0
            self.restarts += 1; self._start_input(self.resolved)
        elif self.bandwidth == 'lowest' and self._good >= 30 and dwell > 45 and self.resolved:
            log.info('link recovered (%ds clean) → bandwidth highest', self._good)
            self.bandwidth = 'highest'; self._last_bw_switch = now; self._good = 0
            self.restarts += 1; self._start_input(self.resolved)

    # state / status ----------------------------------------------------
    def _set_state(self, s):
        if s != self.state:
            log.info('state %s → %s', self.state, s)
            self.state = s
            self._state_t = time.monotonic()
            if s in ('resolving', 'retrying'):
                self._start_slate()      # 'no signal' card while there is no live input
            elif s == 'connecting':
                self._stop_slate()
            self._push_sse()
        else:
            self._state_t = getattr(self, '_state_t', time.monotonic())
        return False

    def snapshot(self):
        c = self.conf
        now = time.monotonic()
        return {
            'node': 'input', 'version': VERSION, 'state': self.state,
            'source': {'configured': c['source'], 'override': self.override,
                       'resolved': self.resolved['name'] if self.resolved else '',
                       'url': (self.resolved or {}).get('url', '')},
            'receiver': c['receiver_name'], 'width': c['width'], 'height': c['height'],
            'size': c['size'], 'source_size': list(self.source_size) if self.source_size else None,
            'pending_size': list(self.pending_size) if self.pending_size else None,
            'settled': self.size_settled(), 'out_frames': self.out_frames,
            'readers': self.device_readers() if self.follow else [],
            'fps': c['fps'] or None, 'fps_measured': self.fps_measured, 'format': c['format'],
            'device': f'/dev/video{c["device"]}', 'bandwidth': self.bandwidth,
            'mode': self.mode, 'auto': self.auto, 'profile': c['profile'],
            'frames': self.frames, 'restarts': self.restarts, 'stalled': self.stalled,
            'nosignal': c['nosignal'],
            'thresholds': {'stall_ms': c['stall_ms'], 'dead_ms': c['dead_ms'], 'hold_ms': c['hold_ms']},
            'last_frame_age_ms': int((now - self.last_frame_t) * 1000) if self.last_frame_t else None,
            'uptime_s': int(time.time() - self.started_at), 'config': c['path'],
        }

    # mutations (called on the GLib thread via idle_add) -----------------
    def set_source(self, name, persist):
        name = (name or '').strip()
        log.info('set source %r persist=%s', name, persist)
        self.override = name
        if persist:
            self._save_override(name)
        # already on air on a source that matches the new name: keep the feed — a show
        # cue re-naming what is playing must not blank the wall for a reconnect
        if self.state == 'running' and self.resolved and name and self._match(name, [self.resolved]):
            log.info('source %r already on air as %r — no restart', name, self.resolved['name'])
            self._apply_pending_size()   # a cue re-selecting the source is the moment its reader has closed the device
            return False
        self.restarts += 1
        self._stop_input()
        self.resolved = None          # status must not keep naming the source a cue just left
        self._set_state('resolving')
        self._resolve_tick()
        return False

    def reset_source(self):
        return self.set_source('', True)

    def set_bandwidth(self, mode):
        mode = (mode or '').lower()
        if mode not in ('highest', 'lowest', 'auto'):
            return False
        self.mode = mode
        self.auto = (mode == 'auto')
        self._bad = self._good = 0; self._last_bw_switch = time.monotonic()
        eff = 'highest' if self.auto else mode        # auto starts at highest, then adapts
        if eff != self.bandwidth:
            self.bandwidth = eff
            if self.resolved:
                self.restarts += 1
                self._start_input(self.resolved)
        return False

    # SSE ---------------------------------------------------------------
    def sse_subscribe(self):
        q = queue.Queue(maxsize=50)
        with self.lock:
            self._sse.append(q)
        return q

    def sse_unsubscribe(self, q):
        with self.lock:
            if q in self._sse:
                self._sse.remove(q)

    def _push_sse(self, heartbeat=False):
        with self.lock:
            qs = list(self._sse)
        if not qs:
            return
        ev = ('heartbeat' if heartbeat else 'status', self.snapshot())
        for q in qs:
            try:
                q.put_nowait(ev)
            except queue.Full:
                pass


# ── API ───────────────────────────────────────────────────────────────────
def make_handler(node):
    class H(BaseHTTPRequestHandler):
        server_version = f'hndi-in/{VERSION}'

        def log_message(self, fmt, *args):
            log.debug('api ' + fmt, *args)

        def _cors(self):
            self.send_header('Access-Control-Allow-Origin', '*')
            self.send_header('Access-Control-Allow-Methods', 'GET, PUT, DELETE, OPTIONS')
            self.send_header('Access-Control-Allow-Headers', 'Content-Type')

        def _json(self, code, obj):
            body = json.dumps(obj).encode()
            self.send_response(code)
            self._cors()
            self.send_header('Content-Type', 'application/json')
            self.send_header('Content-Length', str(len(body)))
            self.send_header('Cache-Control', 'no-store')
            self.end_headers()
            self.wfile.write(body)

        def _body(self):
            n = int(self.headers.get('Content-Length') or 0)
            try:
                return json.loads(self.rfile.read(n) or b'{}')
            except ValueError:
                return {}

        def do_OPTIONS(self):
            self.send_response(204)
            self._cors()
            self.end_headers()

        def do_GET(self):
            if self.path == '/' or self.path == '/index.html':
                body = STATUS_PAGE.encode()
                self.send_response(200); self._cors()
                self.send_header('Content-Type', 'text/html; charset=utf-8')
                self.send_header('Content-Length', str(len(body)))
                self.end_headers(); self.wfile.write(body); return
            if self.path == '/status':
                return self._json(200, node.snapshot())
            if self.path == '/sources':
                return self._json(200, node.sources())
            if self.path == '/events':
                return self._events()
            self._json(404, {'error': 'not found'})

        def do_PUT(self):
            b = self._body()
            if self.path == '/source':
                if not isinstance(b.get('name', ''), str):
                    return self._json(400, {'error': 'name must be a string'})
                GLib.idle_add(node.set_source, b.get('name', ''), bool(b.get('persist')))
                # wait=<s>: block until the device caps are settled for the new source (size=follow
                # rebuilds them once the previous reader — the player between two cues — has closed
                # the device), so the caller opens /dev/videoN with the right caps. Bounded.
                try:
                    wait = min(float(b.get('wait') or 0), 15.0)
                except (TypeError, ValueError):
                    wait = 0.0
                settled = node.size_settled()
                if wait > 0:
                    deadline = time.monotonic() + wait
                    time.sleep(0.05)                 # let set_source run on the GLib thread first
                    while time.monotonic() < deadline:
                        settled = node.size_settled()
                        if settled:
                            break
                        time.sleep(0.05)
                return self._json(202 if not wait else (200 if settled else 202),
                                  {'ok': True, 'name': b.get('name', ''), 'persist': bool(b.get('persist')),
                                   'settled': settled, 'width': node.conf['width'], 'height': node.conf['height'],
                                   'source_size': list(node.source_size) if node.source_size else None})
            if self.path == '/bandwidth':
                if b.get('mode') not in ('highest', 'lowest', 'auto'):
                    return self._json(400, {'error': 'mode must be highest|lowest|auto'})
                GLib.idle_add(node.set_bandwidth, b['mode'])
                return self._json(202, {'ok': True, 'mode': b['mode']})
            self._json(404, {'error': 'not found'})

        def do_DELETE(self):
            if self.path == '/source':
                GLib.idle_add(node.reset_source)
                return self._json(202, {'ok': True})
            self._json(404, {'error': 'not found'})

        def _events(self):
            self.send_response(200)
            self._cors()
            self.send_header('Content-Type', 'text/event-stream')
            self.send_header('Cache-Control', 'no-store')
            self.end_headers()
            q = node.sse_subscribe()
            try:
                self.wfile.write(b'event: status\ndata: ' + json.dumps(node.snapshot()).encode() + b'\n\n')
                self.wfile.flush()
                while True:
                    try:
                        kind, data = q.get(timeout=5)
                    except queue.Empty:
                        kind, data = 'heartbeat', {'t': time.time()}
                    self.wfile.write(f'event: {kind}\ndata: {json.dumps(data)}\n\n'.encode())
                    self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError, OSError):
                pass
            finally:
                node.sse_unsubscribe(q)
    return H


def serve_api(node, port, bind='127.0.0.1'):
    # bind 0.0.0.0 (hndi.conf api_bind) lets a Régie served from another box — casa, the show
    # master — poll /sources on this mini. Read-only listing is harmless; the source switch
    # (POST /source) stays LAN-reachable too, so only do this on a show LAN you control.
    srv = ThreadingHTTPServer((bind, port), make_handler(node))
    srv.daemon_threads = True
    t = threading.Thread(target=srv.serve_forever, name='api', daemon=True)
    t.start()
    log.info('API on http://%s:%d', bind, port)
    return srv


# ── main ──────────────────────────────────────────────────────────────────
def main():
    ap = argparse.ArgumentParser(description='HNdi input node: NDI → v4l2loopback + local API')
    ap.add_argument('--config', help='INI file (default: /boot/firmware/hndi.conf or /boot/hndi.conf)')
    ap.add_argument('--port', type=int, help='API port override')
    ap.add_argument('--dry-run', action='store_true', help='print the pipelines and exit')
    ap.add_argument('-v', '--verbose', action='store_true')
    a = ap.parse_args()
    logging.basicConfig(level=logging.DEBUG if a.verbose else logging.INFO, format='%(levelname)s %(message)s', stream=sys.stderr)

    conf = load_config(a.config)
    if a.port:
        conf['api_port'] = a.port
    sdir = state_dir()
    log.info('hndi-in %s · config %s · state %s', VERSION, conf['path'] or '(defaults)', sdir)
    write_ndi_config(conf, sdir)
    os.environ.setdefault('NDI_CONFIG_DIR', os.path.join(sdir, 'ndi'))
    Gst.init(None)
    if not Gst.ElementFactory.find('ndisrc'):
        log.error('ndisrc element missing — is the gst NDI plugin installed? (hndi doctor)')
        if not a.dry_run:
            sys.exit(3)
    node = Node(conf, sdir, dry_run=a.dry_run)
    node.start()
    if a.dry_run:
        return
    serve_api(node, conf['api_port'], conf.get('api_bind', '127.0.0.1'))
    for s in (signal.SIGINT, signal.SIGTERM):
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, s, lambda *_: (node.stop(), False)[1])
    try:
        node.loop.run()
    finally:
        node.stop()


if __name__ == '__main__':
    main()
