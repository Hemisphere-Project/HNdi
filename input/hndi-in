#!/usr/bin/env python3
"""hndi-in — HNdi input node.

Subscribes to an NDI source and feeds it into a v4l2loopback device so a browser
page can getUserMedia() it. Two GStreamer pipelines in one process:

  output (persistent)  : intervideosrc → caps → v4l2sink /dev/videoN
  input  (restartable) : ndisrc → ndisrcdemux → convert/scale → intervideosink

The output side never restarts while the daemon lives, so Chrome's device keeps
its caps and keeps ticking (black after `timeout` without frames). Source loss,
source switching and bandwidth changes restart only the input side.

Local HTTP API on 127.0.0.1:<api_port> (see ROADMAP.md): GET /status, /sources,
/events (SSE); PUT /source {name, persist}; DELETE /source; PUT /bandwidth {mode}.

Python 3 stdlib + PyGObject only. Runs as root under systemd (hndi-in.service).
"""
import argparse
import configparser
import re
import json
import logging
import os
import queue
import signal
import socket
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import gi
gi.require_version('Gst', '1.0')
from gi.repository import GLib, Gst  # noqa: E402

VERSION = '0.1.2'

